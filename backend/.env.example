# Copie para backend/.env (não versionado). Com o PostgreSQL do docker-compose.yml da raiz:
DATABASE_URL=postgres://globalscholar:globalscholar@localhost:5432/globalscholar
PORT=4000
# Origem do frontend em desenvolvimento (CORS e verificação de origem nas alterações).
CORS_ORIGIN=http://localhost:3000
# Endereço do site (links nos e-mails de redefinição de senha).
APP_URL=http://localhost:3000
# "log": os e-mails (ex.: link de nova senha) aparecem no terminal do backend.
EMAIL_PROVIDER=log
LOG_LEVEL=info
# 1 = cria as bolsas fictícias de demonstração ao iniciar.
SEED_DEMO_DATA=1
