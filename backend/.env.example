# Copie para backend/.env (não versionado). Com o PostgreSQL do docker-compose.yml da raiz:
DATABASE_URL=postgres://globalscholar:globalscholar@localhost:5432/globalscholar
# Para usar o Supabase em vez do Docker: URL do pooler (Session mode) + DATABASE_SSL=require
# DATABASE_SSL=require
PORT=4000
# Origem do frontend em desenvolvimento (CORS e verificação de origem nas alterações).
CORS_ORIGIN=http://localhost:3000
# Endereço do site (links nos e-mails de redefinição de senha).
APP_URL=http://localhost:3000
# "log": os e-mails (ex.: link de nova senha) aparecem no terminal do backend.
EMAIL_PROVIDER=log
LOG_LEVEL=info
# 1 = cria as bolsas fictícias de demonstração ao iniciar.
SEED_DEMO_DATA=1

# Busca automática de bolsas (npm run discovery). Padrão: Gemini, com nível gratuito.
# Chave: aistudio.google.com → Get API key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Teto de chamadas à API por execução (2 por fonte; padrão 40).
# DISCOVERY_MAX_REQUESTS=40
# Opcional: usar o Claude (pago) em vez do Gemini.
# DISCOVERY_PROVIDER=claude
# ANTHROPIC_API_KEY=
# DISCOVERY_MAX_USD=5
