{
  "name": "global-scholarship-frontend",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "next build",
    "start": "next start",
    "mock-api": "node mock-api/server.mjs",
    "mock-api:reset": "node mock-api/server.mjs --reset",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run typecheck && npm run lint && npm run contrast && npm run test && npm run build && npm run size",
    "size": "node scripts/check-bundle-size.mjs",
    "contrast": "node scripts/contrast.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "backend:test": "npm --prefix backend test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "playwright-core": "$playwright-core"
  }
}
