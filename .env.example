NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# "mock" = dados fictícios (apenas desenvolvimento). Qualquer outro valor/ausente = API real.
# Em produção deixe vazio: nenhum dado fictício será usado.
NEXT_PUBLIC_DATA_MODE=
