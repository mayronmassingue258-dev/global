# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Copie para .env.local se quiser mudar algo localmente. Nenhum valor aqui é segredo.

# URL base da API. Com `npm run dev:api` ela já é http://localhost:4000/api automaticamente.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# "mock" = dados fictícios em memória (padrão de `npm run dev`, via .env.development).
# Vazio ou qualquer outro valor = API real. Em produção deixe vazio.
NEXT_PUBLIC_DATA_MODE=

# URL pública do site, para metadados e imagens de compartilhamento. Ex.: https://globalscholar-web.onrender.com
NEXT_PUBLIC_SITE_URL=

# ── API local (npm run mock-api) ──────────────────────────────────────────────
# Estas são lidas do TERMINAL, não deste arquivo. Ex. (macOS/Linux): MOCK_API_DELAY_MS=600 npm run mock-api
# No Windows PowerShell: $env:MOCK_API_DELAY_MS=600; npm run mock-api
# PORT=4000
# HOST=127.0.0.1
# MOCK_API_DATA_FILE=mock-api/.data/db.json
# MOCK_API_DELAY_MS=600        # simula rede lenta (bom para ver estados de carregamento)
# MOCK_API_FAIL_RATE=0.2       # 20% das requisições falham com 503 (bom para ver estados de erro)
# MOCK_API_ALLOW_RESET=1       # use 0 em servidor público
# CORS_ORIGIN=*

# Envio de arquivos dos documentos. Deixe vazio/false até o backend implementar o contrato de arquivos.
NEXT_PUBLIC_UPLOADS_ENABLED=
